<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/ic_splash_heart"
    android:backgroundTint="#FFF4ED"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="12dp">

    <ImageView
        android:id="@+id/widget_heart_icon"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:contentDescription="@string/widget_title"
        android:src="@drawable/ic_notification_heart" />

    <TextView
        android:id="@+id/widget_label"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:text="@string/widget_title"
        android:textColor="#3B2245"
        android:textSize="12sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/widget_status"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Tap to send heartbeat"
        android:textColor="#5A3568"
        android:textSize="10sp" />

</LinearLayout>
