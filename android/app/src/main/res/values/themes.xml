<resources>
    <style name="Theme.Nush" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">true</item>
    </style>

    <!-- Splash Screen theme using androidx.core.splashscreen -->
    <style name="Theme.Nush.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">#18181F</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_calculator</item>
        <item name="postSplashScreenTheme">@style/Theme.Nush</item>
    </style>
</resources>
